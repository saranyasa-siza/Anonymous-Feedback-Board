// Anonymous Feedback Board — Midnight Compact Smart Contract
//
// Privacy Model:
// ─────────────────────────────────────────────────────────────────────────────
// PUBLIC (on-chain ledger):
//   - boardState: whether the board currently displays feedback (VACANT | OCCUPIED)
//   - feedback: the disclosed feedback message text (when occupied)
//   - totalSubmissions: cumulative count of all feedback ever submitted
//   - sequence: rotation counter used for anonymous identity binding
//   - authorHash: anonymous author identifier (hash, NOT the author's secret key)
//
// PRIVATE (witness / local only):
//   - localSecretKey: user's secret key, never stored on-chain
//
// Privacy guarantees:
//   - Submitters prove authorship via zero-knowledge proofs without revealing their
//     secret key on the ledger.
//   - Only a hashed public key (authorHash) is disclosed, unlinkable to wallet identity.
//   - Only the original anonymous author can remove their own feedback.
// ─────────────────────────────────────────────────────────────────────────────

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  VACANT,
  OCCUPIED
}

export ledger state: State;

export ledger feedback: Maybe<Opaque<"string">>;

export ledger totalSubmissions: Counter;

export ledger sequence: Counter;

export ledger authorHash: Bytes<32>;

constructor() {
  state = State.VACANT;
  feedback = none<Opaque<"string">>();
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit submitFeedback(newFeedback: Opaque<"string">): [] {
  assert(state == State.VACANT, "Attempted to submit feedback while board is occupied");
  authorHash = disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>));
  feedback = disclose(some<Opaque<"string">>(newFeedback));
  state = State.OCCUPIED;
  totalSubmissions.increment(1);
}

export circuit removeFeedback(): Opaque<"string"> {
  assert(state == State.OCCUPIED, "Attempted to remove feedback from an empty board");
  assert(authorHash == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Attempted to remove feedback, but not the original author");
  const formerFeedback = feedback.value;
  state = State.VACANT;
  sequence.increment(1);
  feedback = none<Opaque<"string">>();
  return formerFeedback;
}

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "feedback-board:pk:"), sequence, sk]);
}
